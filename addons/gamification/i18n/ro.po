"value=\"line['goals'][:3]\"/>\n"
"                                                    <t t-"
"foreach=\"top_goals\" t-as=\"goal\">\n"
"                                                        <td align=\"center\" "
"style=\"width:32%;\">\n"
"                                                            <t t-"
"if=\"loop.index == 1\">\n"
"                                                                <t t-"
"set=\"extra_div\" t-value=\"'&lt;div style=&quot;height:40px;&quot;&gt;&lt;/"
"div&gt;'\"/>\n"
"                                                                <t t-"
"set=\"heightA\" t-value=\"95\"/>\n"
"                                                                <t t-"
