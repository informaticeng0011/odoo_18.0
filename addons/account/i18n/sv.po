" </t>\n"
" <t t-else=\"\">\n"
" faktura\n"
" </t>\n"
" <t t-if=\"object.invoice_origin\">\n"
" (med referens: <t t-out=\"object.invoice_origin eller ''\">SUB003</t>)\n"
" </t>\n"
" summa <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) eller ''\">143 750,00 $</span>\n"
