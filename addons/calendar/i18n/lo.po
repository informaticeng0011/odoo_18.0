"                        <div style=\"font-size: 10px; font-weight: normal\">"
"\n"
"                            (<t t-out=\"object.mail_tz or ''\">Europe/"
"Brussels</t>)\n"
"                        </div>\n"
"                    </t>\n"
"                </t>\n"
"            </div>\n"
"        </td>\n"
"        <td width=\"20px;\"></td>\n"
"        <td style=\"padding-top: 5px;\">\n"
"            <p><strong>ລາຍລະອຽດຂອງເຫດການ</strong></p>\n"
"            <ul>\n"
"                <t t-if=\"is_online\">\n"
"                    <li>ປະເພດການນັດໝາຍ: <t t-"
"out=\"object.event_id.appointment_type_id.name or ''\">Schedule a Demo</t></"
"li>\n"
"                </t>\n"
"                <t t-if=\"object.event_id.location\">\n"
"                    <li>ສະຖານທີ່: <t t-out=\"object.event_id.location or ''\">"
"Bruxelles</t>\n"
"                        (<a target=\"_blank\" t-attf-href=\"http://"
"maps.google.com/maps?oi=map&amp;q={{object.event_id.location}}\">ເບິ່ງແຜນທີ່</a>)"
"\n"
"                    </li>\n"
"                </t>\n"
"                <t t-if=\"recurrent\">\n"
"                    <li>ເວລາ: <t t-out=\"object.recurrence_id.name or ''\">"
"Every 1 Weeks, for 3 events</t></li>\n"
"                </t>\n"
"                <t t-if=\"not object.event_id.allday and "
"object.event_id.duration\">\n"
"                    <li>ໄລຍະເວລາ: <t t-out=\"('%dH%02d' % "
